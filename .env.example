# ==============================================================
#  Copia este archivo como ".env" y completa tus valores.
#  ¡NUNCA subas .env a GitHub! (ya está en .gitignore)
#  Genera claves aleatorias con:  npm run seguridad:clave
# ==============================================================

PORT=3000
NODE_ENV=development
# URL pública de la app. En producción DEBE ser https:// (ej. https://alc-internacional.vercel.app)
APP_URL=http://localhost:3000

# --------------------------------------------------------------
#  BASE DE DATOS · SUPABASE (accesos y datos de la plataforma)
#  Supabase → Connect → Connection String → Method: "Session pooler"
#  Si la contraseña tiene símbolos, codifícalos: @ → %40  # → %23  / → %2F
# --------------------------------------------------------------
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_POOL_MAX=5
# (Recomendado) certificado de Supabase para VERIFICAR el servidor:
# Project Settings → Database → SSL Configuration → Download certificate
# DATABASE_SSL_CA=./certs/prod-ca-2021.crt

# --------------------------------------------------------------
#  SEGURIDAD (dos claves DISTINTAS, 64 caracteres hex cada una)
# --------------------------------------------------------------
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=8h
# Solo estos dominios pueden solicitar cuenta (separados por coma). Vacío = cualquiera (igual requiere aprobación)
ALLOWED_EMAIL_DOMAINS=aliclik.app
# Excepciones: correos exactos permitidos aunque no sean del dominio (ej. la cuenta personal de desarrollo)
ALLOWED_EMAILS=

# --------------------------------------------------------------
#  GOOGLE CALENDAR (opcional) · ver docs/GUIA-GOOGLE-CALENDAR.md
# --------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendario/google/callback
CALENDAR_SYNC_MINUTES=5
# Para el cron de Vercel (clave aleatoria larga)
CRON_SECRET=

# --------------------------------------------------------------
#  AURORA (opcional, solo para  npm run sync:aurora)
#  Usar SIEMPRE un usuario de SOLO LECTURA. Ver docs/SINCRONIZACION.md
# --------------------------------------------------------------
AURORA_HOST=
AURORA_PORT=3306
AURORA_USER=
AURORA_PASSWORD=
AURORA_DATABASE=
# AURORA_SSL_CA=./certs/global-bundle.pem
AURORA_DIAS=45
# Fecha mínima: nunca se traen pedidos creados antes (hora de Aurora, UTC)
AURORA_INICIO=2026-10-01 00:00:00
# Zona horaria en que Aurora guarda sus fechas: UTC (por defecto) o America/Lima
AURORA_TIMEZONE=UTC
