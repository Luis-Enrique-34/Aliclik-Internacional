{
  "name": "aliclik-internacional",
  "version": "1.0.0",
  "description": "Plataforma interna de monitoreo de pedidos internacionales de Aliclik (tiendas, proveedores, almacenes y couriers) con calendario sincronizado con Google",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"tests/unit/*.test.js\"",
    "db:test": "node database/test-connection.js",
    "db:init": "node database/init.js",
    "db:seed": "node database/seed.js",
    "db:admin": "node database/crear-admin.js",
    "sync:aurora": "node scripts/sync-aurora.js",
    "seguridad:auditar": "npm audit --omit=dev",
    "seguridad:clave": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "test:integracion": "node --test --test-reporter=spec --test-concurrency=1 \"tests/integration/*.test.js\""
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.6"
  },
  "engines": {
    "node": ">=20"
  }
}
